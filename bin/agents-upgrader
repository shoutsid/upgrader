#!/usr/bin/env ruby
# frozen_string_literal: true

# The load path is set here rather than through a Gemfile, because this tool has no
# dependencies to resolve: a `bundle exec` in front of a program that needs nothing
# is a dependency on Bundler dressed up as hygiene.
$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "agents/upgrader"

exit Agents::Upgrader::CLI.new(ARGV).run
