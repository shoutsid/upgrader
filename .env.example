# A template for a deployment's environment, not a file the client reads itself.
# A shell, a compose file or a secret manager loads these; the CLI has no config file.
# Copy to `.env` (ignored by git) and edit. Never commit a real key or token.

# --- the service -------------------------------------------------------------
# There is no default service. `plan`, `preflight`, `step` and `serve` need one.
AGENTS_FYI_URL=https://agents.shoutsid.fyi
# An operator key, never an admin token. Empty means anonymous reads only.
AGENTS_FYI_KEY=

# --- the loop (entrypoint.sh) ------------------------------------------------
# The service as the container reaches it on its own network.
API_BASE_URL=http://service:8001
# The Rails release every move ends at. Empty idles unless UPGRADER_WALK is set or the
# project declaration supplies a target.
UPGRADER_TO=
# native, docker or rvm. See docs/configuration.md#choosing-a-machine.
UPGRADER_RUNTIME=native
# Set to any non-empty value to chain rungs / publish passed rungs.
UPGRADER_WALK=
UPGRADER_PUBLISH=
UPGRADER_FORCE=
# How long an idle cycle waits, and the ceiling for one application suite.
UPGRADER_INTERVAL=600
UPGRADER_STEP_TIMEOUT=3600
# Rungs a --walk cycle may chain, and an optional proof-run cycle bound.
UPGRADER_RUNGS=3
UPGRADER_CYCLES=
# Optional: a project declaration and the directory that shadows the built-ins.
UPGRADER_PROJECT=
UPGRADER_PROJECTS_DIR=
# Optional: where the loop writes records.
UPGRADER_RECORD=
# The public base a review brief links reports to.
UPGRADER_PUBLIC_URL=https://agents.shoutsid.fyi
# KEY=VALUE lines for the application's suite, or a path already inside the container.
UPGRADER_SUITE_ENV=
UPGRADER_SUITE_ENV_FILE=

# --- one-shot publishing (step --publish only) -------------------------------
# The loop's serve --publish uses the service's GitHub App credential instead.
# UPGRADER_GITHUB_TOKEN=

# --- the step image ----------------------------------------------------------
# With UPGRADER_RUNTIME=docker, the loop needs the host's Docker socket and its group.
# UPGRADER_DOCKER_GID=999
# UPGRADER_DOCKER_VOLUME=
# UPGRADER_INTERPRETER_IMAGES=

# --- repair (off by default; the only setting that spends money) -------------
# UPGRADER_REPAIR_ATTEMPTS=0
# UPGRADER_REPAIR_TIMEOUT=600
# UPGRADER_REPAIR_MODEL=
